NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
IP_HASH_SALT=
# Proxies de confianza delante de la app (Vercel: 1). Con 0 se ignora x-forwarded-for.
TRUSTED_PROXY_HOPS=1
# Correo por SMTP. En local lo recoge Mailpit (http://127.0.0.1:54324). En produccion, p. ej. Resend: smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM="Ekklesias <no-reply@ekklesias.local>"
# URL publica para los enlaces de los emails (si falta, se deduce de la peticion)
SITE_URL=
